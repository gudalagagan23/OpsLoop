# Copy to .env and fill in. Never commit .env.

# Postgres (local docker compose only)
POSTGRES_USER=opsloop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opsloop
POSTGRES_HOST_PORT=55432

# Host-side URL for running tests outside Docker
OPSLOOP_DATABASE_URL=postgresql+psycopg://opsloop:change-me@localhost:55432/opsloop

# LLM / embeddings (needed from Stage 2). Model names stay in env, never in code.
# ANTHROPIC_API_KEY=
# OPSLOOP_LLM_MODEL=
# OPSLOOP_EMBEDDING_MODEL=
