# Copy to .env and fill in. Never commit .env.

# Postgres (local docker compose only)
POSTGRES_USER=opsloop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opsloop
POSTGRES_HOST_PORT=55432

# Host-side URL for running tests outside Docker
OPSLOOP_DATABASE_URL=postgresql+psycopg://opsloop:change-me@localhost:55432/opsloop

# LLM / embeddings (needed from Stage 2). Model names stay in env, never in code.
# Create a key in the Anthropic Console and paste it here yourself. Never commit .env.
ANTHROPIC_API_KEY=
OPSLOOP_LLM_MODEL=
OPSLOOP_LLM_EFFORT=high
# Per-million-token prices for cost tracking (look them up for your chosen model).
OPSLOOP_LLM_INPUT_USD_PER_MTOK=0
OPSLOOP_LLM_OUTPUT_USD_PER_MTOK=0
OPSLOOP_LLM_CACHE_READ_USD_PER_MTOK=0
OPSLOOP_LLM_CACHE_WRITE_USD_PER_MTOK=0

# Local embeddings (downloaded once, then offline).
OPSLOOP_EMBEDDING_PROVIDER=fastembed
OPSLOOP_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
